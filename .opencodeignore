# ===========================================
# OpenCode Context Ignore
# Prevents these files from being auto-loaded
# into the AI context window
# ===========================================

# === Heavy Directories ===
node_modules/
.git/
dist/
out/
build/
coverage/
.venv/
venv/
__pycache__/
.pytest_cache/
.mypy_cache/
htmlcov/
.worktrees/
.auto-claude/

# === Large Binary/Generated Files ===
*.exe
*.dmg
*.AppImage
*.deb
*.rpm
*.msi
*.asar
*.blockmap
*.snap
*.flatpak
*.egg
*.whl
*.pyc
*.pyo
*.so
*.dll

# === Logs ===
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Lock Files (large, not useful for context) ===
package-lock.json
yarn.lock
pnpm-lock.yaml
uv.lock
Pipfile.lock
poetry.lock

# === IDE/Editor ===
.idea/
.vscode/
*.swp
*.swo

# === Environment/Secrets ===
.env
.env.*
*.pem
*.key
*.crt
secrets/
credentials/

# === Test Artifacts ===
test-results/
playwright-report/
playwright/.cache/
.nyc_output/
*.cover

# === Cache ===
.cache/
.parcel-cache/
.turbo/
.eslintcache
.prettiercache

# === Assets (images are large and not needed for code context) ===
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.svg
*.webp
*.mp4
*.webm
.github/assets/

# === Documentation (can be loaded on-demand) ===
docs/
guides/
*.md
!CLAUDE.md
!README.md
!apps/backend/prompts/**/*.md

# === Misc ===
*.bak
*.tmp
*.temp
*.local
dev/
_bmad/
_bmad-output/
.claude/
